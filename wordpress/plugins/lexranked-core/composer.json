{
    "name": "lexranked/lexranked-core",
    "description": "LexRanked core WordPress plugin: data model, ranking engine and REST API.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "LexRanked\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LexRanked\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint:syntax": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
        "lint": ["@lint:syntax", "phpcs"],
        "lint:fix": "phpcbf",
        "test": "phpunit"
    }
}
