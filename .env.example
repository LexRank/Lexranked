# LexRanked environment template.
# Copy to .env (docker-compose) and frontend/.env.local (Next.js). Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and are never sent to the browser.

# --- Frontend (Next.js) -------------------------------------------------------
# Public canonical origin. Safe to expose.
NEXT_PUBLIC_SITE_URL=https://lexranked.com

# Search-engine indexing is opt-in. Set to "true" only on the production deployment.
# Vercel preview/development deployments are always noindex regardless of this value.
ALLOW_INDEXING=false

# --- WordPress CMS / LexRanked REST API ---------------------------------------
# Local docker-compose: http://localhost:8080/wp-json
WORDPRESS_API_URL=https://wp.lexranked.com/wp-json
# User with the "LexRanked API" role + an Application Password (Users > Edit > Application Passwords).
# Optional: only exempts the frontend from public rate limits. Server-side only.
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# --- Workers (Phase 5+) --------------------------------------------------------
# Server-side only. Never expose to the frontend.
OPENAI_API_KEY=
RESEARCH_API_KEY=

# --- Local development only (docker-compose) -----------------------------------
# These credentials are for the throwaway local database. Do not reuse in production.
LOCAL_WP_PORT=8080
LOCAL_DB_NAME=lexranked
LOCAL_DB_USER=lexranked
LOCAL_DB_PASSWORD=change-me-local-only
LOCAL_DB_ROOT_PASSWORD=change-me-local-root-only
